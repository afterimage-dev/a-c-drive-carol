{
  "name": "a-c-drive-carol",
  "productName": "A C-Drive Carol",
  "version": "0.1.0",
  "description": "A retelling of the greatest ghost story in English, where the miser is you and the hoard is your hard drive.",
  "author": "Nicholas Tweedale",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "engines": {
    "node": ">=18.15"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "sample": "node core/make-sample.js",
    "scan": "node core/scan.js",
    "lines": "node core/manifest.js",
    "dist": "electron-builder --win nsis portable"
  },
  "dependencies": {
    "@fontsource/abril-fatface": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/old-standard-tt": "5.3.0",
    "@pixi/unsafe-eval": "7.4.2",
    "koffi": "3.3.2",
    "pixi.js": "7.4.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.afterimage.acdrivecarol",
    "productName": "A C-Drive Carol",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "core/*.js",
      "core/sample-manifest.json",
      "assets/sprites/layers/*.webp",
      "assets/sprites/*_glow.webp",
      "assets/sprites/*_spawn.json",
      "assets/sprites/link.webp",
      "assets/sprites/edge.webp",
      "assets/sprites/padlock.webp",
      "assets/sprites/stone.webp",
      "assets/sounds/*.mp3",
      "assets/icon.png",
      "assets/tray.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false
    },
    "portable": {
      "artifactName": "A-C-Drive-Carol-portable-${version}.exe"
    }
  }
}
